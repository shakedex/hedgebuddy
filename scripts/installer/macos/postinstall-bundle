#!/bin/bash
# postinstall-bundle — Runs after pkgbuild installs the HedgeBuddy Suite.
# Copies the Quills LaunchAgent plist to the installing user's home and loads it.

PLIST_SRC="/usr/local/share/quills/io.github.shakedex.quills.plist"

# Resolve the real user's home directory (installer may run as root).
if [ "$EUID" -eq 0 ] && [ -n "$USER" ]; then
    USER_HOME=$(eval echo "~$USER")
else
    USER_HOME="$HOME"
fi

TARGET_DIR="${USER_HOME}/Library/LaunchAgents"
mkdir -p "$TARGET_DIR"

cp "$PLIST_SRC" "$TARGET_DIR/io.github.shakedex.quills.plist"
chmod 644 "$TARGET_DIR/io.github.shakedex.quills.plist"

# Move HedgeBuddy.app from /Users/Shared/Applications to the user's ~/Applications.
SHARED_APP="/Users/Shared/Applications/HedgeBuddy.app"
USER_APPS="${USER_HOME}/Applications"
mkdir -p "$USER_APPS"
if [ -d "$SHARED_APP" ]; then
    cp -r "$SHARED_APP" "$USER_APPS/HedgeBuddy.app"
    rm -rf "$SHARED_APP"
fi

# Load the Quills LaunchAgent for the current user (non-fatal).
if command -v launchctl &>/dev/null; then
    launchctl load "$TARGET_DIR/io.github.shakedex.quills.plist" 2>/dev/null || true
fi

exit 0
