{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test:python-lib",
      "type": "shell",
      "command": "& .\\.venv\\Scripts\\python.exe -m pytest -q",
      "options": {
        "cwd": "${workspaceFolder}/python-lib"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "install:python-lib-editable",
      "type": "shell",
      "command": "& .\\.venv\\Scripts\\python.exe -m pip install -e .[dev]",
      "options": {
        "cwd": "${workspaceFolder}/python-lib"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev:app",
      "type": "shell",
      "command": "$env:PATH = 'C:\\msys64\\ucrt64\\bin;' + $env:PATH; $env:CGO_ENABLED = '1'; go run .",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build:app",
      "type": "shell",
      "command": "$env:PATH = 'C:\\msys64\\ucrt64\\bin;' + $env:PATH; $env:CGO_ENABLED = '1'; go build -o hedgebuddy.exe .",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build:updater",
      "type": "shell",
      "command": "go build -o updater.exe .",
      "options": {
        "cwd": "${workspaceFolder}/updater"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "vet:updater",
      "type": "shell",
      "command": "go vet ./...",
      "options": {
        "cwd": "${workspaceFolder}/updater"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
